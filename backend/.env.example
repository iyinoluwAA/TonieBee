# Database connection string
DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/toniebee

# JWT secret key for signing tokens (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your-secret-key-here

# JWT token max age in seconds (86400 = 24 hours)
JWT_MAXAGE=86400

# Optional: Set to 'development' for dev mode (enables debug prints)
# RUST_ENV=development

# Optional: SMTP settings for email (if using MailHog for dev)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
