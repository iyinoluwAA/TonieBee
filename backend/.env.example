# Copy to backend/.env for local development (backend/.env is git-ignored).
# In production these come from the host's settings (Render), never from a file.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Local database from backend/docker-compose.yml (port 5436)
DATABASE_URL=postgres://toniebee:toniebee-dev-only@localhost:5436/toniebee

# The website: the only origins allowed to sign in or change anything (exact match,
# comma-separated), and the address used in links inside emails.
FRONTEND_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173

# The business name in emails and the authenticator app. Before launch it must be
# the name exactly as on the owner's licence (README → "Before launch").
BRAND_NAME=Toniebee

# Provinces she's licensed in (two-letter codes). Unset = all 13 for now.
# SERVICE_PROVINCES=ON

# Two different secret keys, 64 hex characters each. Generate each with:
#   openssl rand -hex 32
# Never commit real ones; never reuse the development keys in production.
#   AUTH_SECRET          scrambles sign-in codes and backup codes
#   DATA_ENCRYPTION_KEY  encrypts admins' authenticator secrets (changing it means
#                        re-running create-admin for every admin)
AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# Email: "log" prints emails (with their sign-in links) to the server log.
# Development only — the server refuses it in production.
MAIL_PROVIDER=log
# Real email, e.g. Brevo's free plan (README → "Email"). Test with:
#   cargo run -- check-email you@example.com
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=          (Brevo → SMTP login)
# SMTP_PASSWORD=          (Brevo → SMTP key; a secret)
# MAIL_FROM=              (an address the email service has verified)
# MAIL_FROM_NAME=Toniebee
# MAIL_REPLY_TO=          (the owner's business inbox)

# Proxies in front of the API that append to X-Forwarded-For (0 = none).
# Set at go-live; see README → "Client IP".
TRUSTED_PROXY_HOPS=0

RUST_LOG=toniebee_api=debug,tower_http=info
