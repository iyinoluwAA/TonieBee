# Keep the repo private-safe: ignore everything at the root by default, then
# allow only the project folders. AJ's private notes (HANDOFF.md, the old
# planning files, AI-chat digests and zips) sit at the root and can never be
# committed by accident.
/*
!/.gitignore
!/README.md
!/render.yaml
!/frontend/
!/backend/
!/tools/
!/docs/
!/.github/

# Within tracked folders: never commit dependencies, build output or secrets.
node_modules/
dist/
dist-ssr/
target/
coverage/
.env
.env.*
!.env.example
*.pem
*.key

# Test pages that may hold development sign-in details (see tools/README.md).
/frontend/public/_dev/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.log
__pycache__/
.eslintcache
.stylelintcache
!/Dockerfile
!/.dockerignore
